{
  "dashboard": {
    "title": "TarsEnterprise — 万物皆 MCP 监控看板",
    "tags": ["tarsenterprise", "mcp", "gateway"],
    "timezone": "browser",
    "schemaVersion": 36,
    "panels": [
      {
        "id": 1, "title": "Agent 调用总量", "type": "stat",
        "targets": [{"expr": "te_agent_calls_total", "legendFormat": "{{agent_id}}"}],
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
      },
      {
        "id": 2, "title": "Agent 错误率", "type": "stat",
        "targets": [{"expr": "te_agent_errors_total", "legendFormat": "errors"}],
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
      },
      {
        "id": 3, "title": "Top 5 Agents", "type": "table",
        "targets": [{"expr": "topk(5, te_agent_calls_total)"}],
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
      },
      {
        "id": 4, "title": "P50 延迟", "type": "graph",
        "targets": [{"expr": "te_agent_latency_seconds{quantile=\"0.5\"}"}],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 5, "title": "P95 延迟", "type": "graph",
        "targets": [{"expr": "te_agent_latency_seconds{quantile=\"0.95\"}"}],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 6, "title": "网关状态", "type": "stat",
        "targets": [{"expr": "up{job=\"tarsenterprise\"}"}],
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 16}
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "5s"
  }
}
